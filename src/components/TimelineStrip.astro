---
import { CATS, ERAS, EVENTS, MODELS, MODELS_TRAINED, RANGE, UNIVERSE } from "../data/timeline";

const W = 1160, L = 46, R = 46, LANE = 22, BAND = 24, CHAR = 6.4;
const t0 = Date.parse(RANGE.start), t1 = Date.parse(RANGE.end);
const x = (d: string) => L + ((Date.parse(d) - t0) / (t1 - t0)) * (W - L - R);
const dayAfter = (d: string) => new Date(Date.parse(d) + 86_400_000).toISOString().slice(0, 10);

const MAX_LANES = 20;
type Side = "right" | "edge" | "left";
const items = EVENTS.filter((e) => e.strip)
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((e) => {
    const px = x(e.date);
    const w = e.strip!.length * CHAR + 10;
    const side: Side = px + w > W - R ? "edge" : "right";
    return { e, px, w, side: side as Side, l: side === "edge" ? W - R - w : px, lane: 0 };
  });
type Item = (typeof items)[number];
const GAP = 6;
const covers = (it: Item, px: number) => px > it.l - GAP && px < it.l + it.w + GAP;
const placed: Item[] = [];
const fits = (it: Item, lane: number) =>
  placed.every((p) =>
    p.lane === lane
      ? it.l + it.w + GAP < p.l || p.l + p.w + GAP < it.l
      : p.lane < lane
        ? it.px === p.px || !covers(p, it.px)
        : !(it.px !== p.px && covers(it, p.px)),
  );
const firstLane = (it: Item) => Array.from({ length: MAX_LANES }, (_, i) => i).find((lane) => fits(it, lane));
for (const it of items) {
  it.lane = firstLane(it) ?? MAX_LANES - 1;
  placed.push(it);
}

const valid = (it: Item, lane: number, l: number) =>
  items.every((p) => {
    if (p === it) return true;
    const pc = (px: number) => px > l - GAP && px < l + it.w + GAP;
    if (p.lane === lane) return l + it.w + GAP < p.l || p.l + p.w + GAP < l;
    if (p.lane < lane) return it.px === p.px || !covers(p, it.px);
    return it.px === p.px || !pc(p.px);
  });
for (let pass = 0, moved = true; moved && pass < 20; pass++) {
  moved = false;
  for (const it of [...items].sort((a, b) => b.lane - a.lane)) {
    const options: { side: Side; l: number }[] = [{ side: it.side === "edge" ? "edge" : "right", l: it.side === "edge" ? W - R - it.w : it.px }];
    if (it.side !== "edge" && it.px - it.w > L) options.push({ side: "left", l: it.px - it.w });
    for (let lane = 0; lane < it.lane && !moved; lane++) {
      const o = options.find((o) => valid(it, lane, o.l));
      if (o) {
        Object.assign(it, o, { lane });
        moved = true;
      }
    }
  }
}
const nLanes = Math.max(8, Math.max(...items.map((i) => i.lane)) + 1);
const axisY = 10 + nLanes * LANE + 8;
const H = axisY + BAND + 22;
const laneY = (lane: number) => axisY - 10 - lane * LANE;

const TOP = 22;
const uy = (v: number) => axisY - Math.sqrt(v / 300) * (axisY - TOP);
const uEnd = W - R;
let uPath = `M${x(UNIVERSE[0][0]).toFixed(1)},${axisY}`;
UNIVERSE.forEach(([d, v], i) => {
  uPath += `V${uy(v).toFixed(1)}H${(i + 1 < UNIVERSE.length ? x(UNIVERSE[i + 1][0]) : uEnd).toFixed(1)}`;
});
uPath += `V${axisY}Z`;
const hits = (cx: number, cy: number, w: number) =>
  placed.some((p) => cx + w / 2 > p.l - 4 && cx - w / 2 < p.l + p.w + 4 && cy + 2 > laneY(p.lane) - 12 && cy - 10 < laneY(p.lane) + 3);
const uLabels = UNIVERSE.flatMap(([d, v], i) => {
  if (i > 0 && v < 2 * UNIVERSE[i - 1][1]) return [];
  let j = i + 1;
  while (j < UNIVERSE.length && UNIVERSE[j][1] < 2 * v) j++;
  const text = `${v} names`;
  const w = text.length * 5.6;
  if (j >= UNIVERSE.length) return [{ px: W - R - 4, py: uy(v), text, anchor: "end" }];
  const a = x(d), b = x(UNIVERSE[j][0]);
  const f = [0.35, 0.5, 0.2, 0.65, 0.1, 0.8, 0.9].find((f) => !hits(a + f * (b - a), uy(v) + 11, w)) ?? 0.35;
  return [{ px: a + f * (b - a), py: uy(v), text, anchor: "middle" }];
});

const mMax = MODELS[MODELS.length - 1][1];
const my = (v: number) => axisY - (v / mMax) * (axisY - TOP) * 0.8;
let mPath = `M${x(MODELS[0][0]).toFixed(1)},${axisY}`;
MODELS.forEach(([d, v]) => {
  mPath += `H${x(d).toFixed(1)}V${my(v).toFixed(1)}`;
});
mPath += `H${uEnd.toFixed(1)}`;
const modelsLabel = `~${Math.round(MODELS_TRAINED / 1000)}k models trained`;
const nameTicks = [5, 50, 100, 200, 300];
// every 10k up to the current total, so the axis grows with MODELS
const modelTicks = Array.from({ length: Math.floor(mMax / 10_000) + 1 }, (_, i) => i * 10_000);

const months: string[] = [];
for (let d = new Date(Date.UTC(2025, 10, 1)); x(d.toISOString()) + 40 < W; d.setUTCMonth(d.getUTCMonth() + 1)) {
  months.push(d.toISOString().slice(0, 10));
}
const mLabel = (d: string) =>
  new Date(d).toLocaleDateString("en-US", { month: "short", year: "2-digit", timeZone: "UTC" }).replace(" ", " '");
---

<div class="strip-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Overview timeline of project milestones, October 2025 to November 2026, over the universe size (5 to 300 equities)">
    <path d={uPath} class="uni" />
    <path d={mPath} class="models" />
    <text x={2} y={TOP - 10} class="axt uni-ax">Equities</text>
    {
      nameTicks.map((v) => (
        <g>
          <line x1={L - 3} x2={L} y1={uy(v)} y2={uy(v)} class="axtick uni-tick" />
          <text x={L - 6} y={uy(v) + 3.5} text-anchor="end" class="axt uni-ax">{v}</text>
        </g>
      ))
    }
    <text x={W - R + 6} y={TOP - 10} class="axt mod-ax">Models</text>
    {
      modelTicks.map((v) => (
        <g>
          <line x1={W - R} x2={W - R + 3} y1={my(v)} y2={my(v)} class="axtick mod-tick" />
          <text x={W - R + 6} y={my(v) + 3.5} class="axt mod-ax">{v ? `${v / 1000}k` : "0"}</text>
        </g>
      ))
    }
    <text x={uEnd - 4} y={my(mMax) + 12} text-anchor="end" class="modlab">{modelsLabel}</text>
    {
      uLabels.map((u) => (
        <text x={u.px} y={u.py + 11} text-anchor={u.anchor} class="unilab">{u.text}</text>
      ))
    }
    {
      ERAS.map((era, i) => {
        const a = x(era.start), b = i === ERAS.length - 1 ? uEnd : x(dayAfter(era.end));
        return (
          <g>
            <rect x={a} y={axisY} width={b - a} height={BAND} style={`fill:${i % 2 ? "#e2e7ed" : "#eef1f4"}`} />
            <text x={a + 6} y={axisY + 16} class="era">{era.name}</text>
          </g>
        );
      })
    }
    {
      items.map((it) => (
        <g>
          <line x1={it.px} x2={it.px} y1={laneY(it.lane) + 4} y2={axisY} class="tick" />
          <rect x={it.px - 3.5} y={axisY - 3.5} width="7" height="7" style={`fill:${CATS[it.e.cat].color}`} />
          <text
            x={it.side === "edge" ? W - R - 5 : it.side === "left" ? it.px - 5 : it.px + 5}
            y={laneY(it.lane)}
            text-anchor={it.side === "right" ? "start" : "end"}
            class="lab"
            style={`fill:${CATS[it.e.cat].color}`}
          >
            {it.e.strip}
          </text>
        </g>
      ))
    }
    {
      months.map((m) => (
        <g>
          <line x1={x(m)} x2={x(m)} y1={axisY + BAND} y2={axisY + BAND + 5} class="tick" />
          <text x={x(m) + 3} y={H - 4} class="mon">{mLabel(m)}</text>
        </g>
      ))
    }
  </svg>
</div>

<style>
  .strip-scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
    padding: 8px 8px 4px;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 900px;
    height: auto;
    font-family: var(--f-sans);
  }
  .lab {
    font-size: 11.5px;
    fill: var(--ink);
  }
  .era {
    font-size: 11px;
    font-weight: 600;
    fill: var(--ink-2);
  }
  .mon {
    font-size: 10.5px;
    fill: var(--ink-3);
  }
  .uni {
    fill: var(--c-universe);
    fill-opacity: 0.07;
    stroke: var(--c-universe);
    stroke-opacity: 0.35;
    stroke-width: 1;
  }
  .unilab {
    font-size: 10px;
    fill: var(--c-universe);
    fill-opacity: 0.85;
  }
  .axt {
    font-size: 10px;
  }
  .uni-ax {
    fill: var(--c-universe);
  }
  .mod-ax {
    fill: #1f8fb3;
  }
  .axtick {
    stroke-width: 1;
  }
  .uni-tick {
    stroke: var(--c-universe);
  }
  .mod-tick {
    stroke: #1f8fb3;
  }
  .models {
    fill: none;
    stroke: #1f8fb3;
    stroke-width: 1.5;
    stroke-opacity: 0.8;
  }
  .modlab {
    font-size: 10px;
    fill: #1f8fb3;
  }
  .lab,
  .unilab,
  .modlab {
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .tick {
    stroke: var(--rule);
    stroke-width: 1;
  }
</style>
